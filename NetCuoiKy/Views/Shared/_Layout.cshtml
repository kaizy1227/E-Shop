<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Shopping</title>
    <meta name="description" content="Chào mừng bạn đến với E-Shopping. Đây là trang bán hàng online với những phụ kiện thể thao dành cho Nam như quần áo, đồng hồ, giày dép. Mục đích của chúng tôi là làm cho nhiều người có thể có được niềm vui và lợi ích của việc tập luyện thể thao." />
    <link rel="stylesheet" href="~/Areas/Client/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <script defer src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script defer src="~/Assets/js/bootstrap.min.js"></script>

    @RenderSection("SocialSeo", required: false)

    <script type="application/ld+json">

        {
        "@@context": "http://schema.org",
        "@@type": "Organization",
        "url": "https://onlineshop.somee.com/",
        "logo": "https://onlineshop.somee.com/Areas/Client/images/logone.jpg",
        "description": "OnlineStore bán hàng uy tín...",
        "contactPoint": [{
            "@@type": "ContactPoint",
            "telephone": "0398123982",
            "contactType": "customer service"
        }]
        }
    </script>
</head>

<body>

    <div class="header">
        <div class="container">
            <div class="navbar">
                <div class="logo">
                    <a href="/Home/index"><img src="~/Areas/Client/images/logone.jpg" alt="E-Shopping" width="125" decoding="async"></a>
                </div>
                <nav>
                    @{
                        var session = (UserLogin)Session[NetCuoiKy.Common.CommonConstant.USER_SESSION];
                    }
                    @if (session == null)
                    {
                        <ul id="MenuItems">
                            <li><a href="/home">TRANG CHỦ</a></li>

                            <li><a href="/about/index">GIỚI THIỆU</a></li>
                            <li><a href="/contact/index">LIÊN HỆ</a></li>
                            <li><a href="/user/login">ĐĂNG NHẬP</a></li>
                            <li><a href="/user/register">ĐĂNG KÝ</a></li>
                        </ul>
                    }
                    else
                    {
                        <ul id="MenuItems">
                            <li><a href="/home">TRANG CHỦ</a></li>
                            <li><a href="/about/index">GIỚI THIỆU</a></li>
                            <li><a href="/contact/index">LIÊN HỆ</a></li>
                            <li>Xin chào: @session.UserName</li>
                            <li>@Html.ActionLink("Thoát", "Logout", "User")</li>
                        </ul>
                    }

                </nav>
                <a href="/gio-hang"><img src="~/Areas/Client/images/cart.png" width="30" height="30" alt="Giỏ hàng" decoding="async"></a>
                <img src="~/Areas/Client/images/menu.png" alt="Menu" class="menu-icon" decoding="async"
                     onclick="menutoggle()">
            </div>
            @RenderBody()
            <!-- ------------footer----------- -->

            <div class="footer">
                <div class="container">
                    <div class="row">
                        <div class="footer-col-1">
                            <h3>Tải Ứng Dụng Ngay</h3>
                            <p>Tải ứng dụng cho Android và ios ngay nào</p>
                            <div class="app-logo">
                                <img src="~/Areas/Client/images/play-store.png" alt="Google Play" loading="lazy" decoding="async">
                                <img src="~/Areas/Client/images/app-store.png" alt="App Store" loading="lazy" decoding="async">
                            </div>
                        </div>
                        <div class="footer-col-2">
                            <img src="~/Areas/Client/images/logone.jpg" alt="E-Shopping" loading="lazy" decoding="async">
                            <p>
                                Mục đích của chúng tôi là làm cho nhiều người có thể
                                có được niềm vui và lợi ích của việc tập luyện thể thao.
                            </p>
                        </div>
                        <div class="footer-col-3">
                            <p>Điền mail để nhận thêm thông tin</p>
                            <div id="mc_embed_signup">
                                <form action="https://facebook.us6.list-manage.com/subscribe/post?u=891f4a7ed60f9e33f3bd7256d&amp;id=58e8eff755" method="post" target="_blank">
                                    <label for="mce-EMAIL">Email Address</label>
                                    <input type="email" name="EMAIL" id="mce-EMAIL" required>
                                    <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="b_891f4a7ed60f9e33f3bd7256d_58e8eff755" tabindex="-1" value=""></div>
                                    <input style="width:96%" type="submit" value="Theo dõi" name="subscribe" class="button">
                                </form>
                            </div>
                            <h3>Thông Tin</h3>
                            <ul>
                                <li><a href="#">Khuyến Mãi</li></a>
                                <li><a href="#">Sản Phẩm</li></a>
                                <li><a href="#">Bảo Hành</li></a>
                                <li><a href="#">Hướng dẫn mua hàng</li></a>
                            </ul>
                        </div>
                        <div class="footer-col-4">
                            <h3>Follow us</h3>
                            <ul>
                                <li><a href="#"> <font color="#3C13F2">Facebook</font></a></li>
                                <li><a href="#"> <font color="#3C13F2">Twitter</font></a></li>
                                <li><a href="#"> <font color="#3C13F2">Instagram</font></a></li>
                                <li><a href="#"> <font color="#3C13F2">Youtube</font></a></li>

                            </ul>
                        </div>
                    </div>

                </div>
            </div>
            <!-- ------------------- js for toggle menu-------------- -->
            <script>
                var MenuItems = document.getElementById("MenuItems");

                MenuItems.style.maxHeight = "0px";

                function menutoggle() {
                    if (MenuItems.style.maxHeight == "0px") {
                        MenuItems.style.maxHeight = "200px";
                    }
                    else {
                        MenuItems.style.maxHeight = "0px";
                    }
                }

            </script>
            @RenderSection("jsFooter", required: false)


</body>
</html>


