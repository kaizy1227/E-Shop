
@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listNewProducts = (List<Model.EF.Product>)ViewBag.NewProducts;
    var listFeatureProducts = (List<Model.EF.Product>)ViewBag.ListFeatureProducts;
}
@{ Html.RenderAction("ProductCategory", "Product");}

<div class="row">

    <div class="col-2">
        <h1>Give Your Workout<br> A New Style!</h1>
        <p>
            Success ins't always about greatness. It's about
            consistency. Consistent <br>hard work gains success. Greatness
            will come.
        </p>
        <a href="/san-pham/quan-ao-ne-2" class="btn">Shopping Now &#8594;</a>
    </div>

    <div class="col-2">
        <img src="~/Areas/Client/images/image1-optimized.jpg" alt="Trang phục thể thao E-Shopping" fetchpriority="high" decoding="async">
    </div>
</div>
        </div>
    </div>




<!-- ------------- featured categorries ---------------- -->
<div class="categories">
    <div class="small-container">
        <div class="row">
            <div class="col-3">
                <img src="~/Areas/Client/images/h1.jpg" alt="Bộ sưu tập thể thao" loading="lazy" decoding="async">
            </div>
            <div class="col-3">
                <img src="~/Areas/Client/images/h2.jpg" alt="Bộ sưu tập giày thể thao" loading="lazy" decoding="async">
            </div>
            <div class="col-3">
                <img src="~/Areas/Client/images/h3.jpg" alt="Bộ sưu tập đồng hồ" loading="lazy" decoding="async">
            </div>

        </div>
    </div>

</div>
<!-- ------------- featured products ---------------- -->
<div class="small-container">
    <h2 class="title">Sản Phẩm Mới</h2>
    <div class="row">
        @foreach (var item in listNewProducts)
        {
            var url = "/chi-tiet/" + item.ID + "/" + item.MetaTilte;
            <div class="col-4">
                <a href="@url"><img src="@item.Image" alt="@item.Name" loading="lazy" decoding="async" /></a>
                <a href="@url"><h4>@item.Name</h4></a>
                <div class="rating">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>

                    <h4><a href="/them-gio-hang?productId=@item.ID&quantity=1">Thêm giỏ hàng</a></h4>
                </div>

                <p>@(item.Price.HasValue ? item.Price.Value.ToString("N0"):"Liên hệ") vnđ</p>

            </div>
        }


    </div>
    <h2 class="title">Sản Phẩm Hot</h2>
    <div class="row">
        @foreach (var item in listFeatureProducts)
        {
            var url = "/chi-tiet/" + item.ID + "/" + item.MetaTilte;
            <div class="col-4">
                <a href="@url"><img src="@item.Image" alt="@item.Name" loading="lazy" decoding="async"></a>
                <a href="@url"><h4>@item.Name</h4></a>
                <div class="rating">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star-o"></i>
                    <h4><a href="/them-gio-hang?productId=@item.ID&quantity=1">Thêm giỏ hàng</a></h4>
                </div>
                <p>@(item.Price.HasValue ? item.Price.Value.ToString("N0"):"Liên hệ") vnđ</p>
            </div>
        }
    </div>

</div>
<!-- ------------ offer -------------- -->
<div class="offer">
    <div class="small-container">
        <div class="row">
            <div class="col-2"><img src="~/Areas/Client/images/exclusive.png" alt="Đồng hồ thông minh" class="offer-img" loading="lazy" decoding="async"> </div>
            <div class="col-2">
                <p>Exclusive Availabble on RedStore</p>
                <h1>Smart Watch</h1>
                <small>
                    The  Smart Watch  features a 39.9% larger (than Mi Band 4) AMOLED color full-touch display
                    with
                    adjustable brightness, so everything is clear as can be
                </small>
                <a href="/san-pham/dong-ho-3" class="btn">See Now &#8594;</a>
